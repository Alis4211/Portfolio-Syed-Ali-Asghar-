<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Syed Ali Asghar Shah | Portfolio</title>
    <style>
        /* CSS Variables for Theme */
        :root {
            --bg-color: #0d0d0d;
            --card-bg: #1a1a1a;
            --text-color: #ffffff;
            --accent-red: #d32f2f;
            --accent-glow: rgba(211, 47, 47, 0.6);
        }

        /* Base Styles */
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            line-height: 1.6;
            overflow-x: hidden;
        }

        /* Animations */
        @keyframes fadeInDown {
            from { opacity: 0; transform: translateY(-30px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @keyframes pulseGlow {
            0% { box-shadow: 0 0 10px var(--accent-glow); }
            50% { box-shadow: 0 0 25px var(--accent-red); }
            100% { box-shadow: 0 0 10px var(--accent-glow); }
        }

        @keyframes slideInRight {
            from { opacity: 0; transform: translateX(50px); }
            to { opacity: 1; transform: translateX(0); }
        }

        /* Header Section */
        header {
            text-align: center;
            padding: 4rem 2rem 2rem;
            animation: fadeInDown 1s ease-out;
        }

        .profile-img {
            width: 180px;
            height: 180px;
            border-radius: 50%;
            object-fit: cover;
            border: 4px solid var(--accent-red);
            animation: pulseGlow 3s infinite;
            margin-bottom: 1.5rem;
            transition: transform 0.3s ease;
        }

        .profile-img:hover {
            transform: scale(1.05);
        }

        h1 {
            font-size: 2.5rem;
            margin-bottom: 0.5rem;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        .subtitle {
            color: #aaaaaa;
            font-size: 1.2rem;
            margin-bottom: 2rem;
        }

        /* Buttons & Links */
        .btn {
            display: inline-block;
            background-color: transparent;
            color: var(--text-color);
            border: 2px solid var(--accent-red);
            padding: 10px 24px;
            text-decoration: none;
            border-radius: 30px;
            font-weight: bold;
            transition: all 0.3s ease;
            margin: 0.5rem;
            cursor: pointer;
        }

        .btn:hover {
            background-color: var(--accent-red);
            box-shadow: 0 0 15px var(--accent-red);
            transform: translateY(-3px);
        }

        .btn-solid {
            background-color: var(--accent-red);
        }

        /* Slideshow Section */
        .portfolio-section {
            max-width: 900px;
            margin: 2rem auto;
            padding: 0 1rem;
            animation: fadeInUp 1s ease-out 0.5s both;
        }

        .section-title {
            text-align: center;
            font-size: 2rem;
            margin-bottom: 2rem;
            border-bottom: 2px solid var(--accent-red);
            display: inline-block;
            padding-bottom: 0.5rem;
            left: 50%;
            position: relative;
            transform: translateX(-50%);
        }

        .slideshow-container {
            position: relative;
            background: var(--card-bg);
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
            border: 1px solid #333;
        }

        .slide {
            display: none;
            padding: 2rem;
            text-align: center;
        }

        .slide.active {
            display: block;
            animation: slideInRight 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        }

        /* Iframe Container */
        .iframe-container {
            position: relative;
            width: 100%;
            padding-bottom: 56.25%; /* 16:9 Aspect Ratio */
            margin-bottom: 1rem;
        }

        .iframe-container iframe {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            border: none;
            border-radius: 10px;
        }

        /* Slideshow Controls */
        .controls {
            display: flex;
            justify-content: space-between;
            padding: 1rem 2rem;
            background: #111;
            border-top: 1px solid #333;
        }

        /* Dynamic Links Grid */
        .links-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1rem;
            margin-top: 3rem;
            padding-bottom: 4rem;
        }

        .link-card {
            background: var(--card-bg);
            padding: 1.5rem;
            border-radius: 10px;
            text-align: center;
            border-left: 4px solid var(--accent-red);
            transition: all 0.3s;
        }

        .link-card:hover {
            transform: translateY(-5px) scale(1.02);
            background: #222;
            box-shadow: 0 5px 15px var(--accent-glow);
        }

        .link-card a {
            color: white;
            text-decoration: none;
            font-size: 1.1rem;
            font-weight: bold;
            display: block;
        }

    </style>
</head>
<body>

    <header>
        <img src="pic.jpg" alt="Syed Ali Asghar Shah" class="profile-img">
        <h1>Syed Ali Asghar Shah</h1>
        <p class="subtitle">Computer Engineer & Game Developer</p>
        
        <div>
            <a href="https://ali-asghar-shah.itch.io/" target="_blank" class="btn btn-solid">Visit My Itch.io</a>
            <a href="#projects" class="btn">View Projects</a>
        </div>
    </header>

    <main class="portfolio-section" id="projects">
        <h2 class="section-title">Creative Showcase</h2>

        <div class="slideshow-container">
            
            <div class="slide active">
                <h3>Unity 3D Project Showcase</h3>
                <p style="margin-bottom: 1rem; color: #ccc;">Playable directly in the browser.</p>
                <div class="iframe-container">
                    <iframe src="https://play.unity.com/api/v1/games/game/bf1ba4a3-0fe8-4af8-9eb5-29948391917d/build/latest/frame" allowfullscreen></iframe>
                </div>
            </div>

            <div class="slide">
                <h3>Indie Game Dev Projects</h3>
                <p style="margin-bottom: 2rem; color: #ccc;">Check out my collection of published games and prototypes on Itch.io.</p>
                <a href="https://ali-asghar-shah.itch.io/" target="_blank" class="btn btn-solid" style="padding: 15px 40px; font-size: 1.2rem;">
                    🎮 Open Itch.io Page
                </a>
            </div>

            <div class="slide">
                <h3>Upcoming Project</h3>
                <p style="margin-bottom: 1rem; color: #ccc;">Stay tuned for the next deployment.</p>
                <div style="height: 300px; display: flex; align-items: center; justify-content: center; border: 2px dashed #444; border-radius: 10px;">
                    <span style="color: #666;">New Game Coming Soon</span>
                </div>
            </div>

            <div class="controls">
                <button class="btn" onclick="changeSlide(-1)">&#10094; Prev</button>
                <button class="btn" onclick="changeSlide(1)">Next &#10095;</button>
            </div>
        </div>

        <div style="margin-top: 4rem;">
            <h2 class="section-title">Connect & Discover</h2>
            <div class="links-grid" id="dynamic-links">
                
                <div class="link-card">
                    <a href="https://ali-asghar-shah.itch.io/" target="_blank">🕹️ Itch.io Portfolio</a>
                </div>
                <div class="link-card">
                    <a href="https://play.unity.com/api/v1/games/game/bf1ba4a3-0fe8-4af8-9eb5-29948391917d/build/latest/frame" target="_blank">🌐 Play WebGL Build 1</a>
                </div>

                <div class="link-card">
                    <a href="#" target="_blank">🔗 Add Your Next Link Here</a>
                </div>
                </div>
        </div>
    </main>

    <script>
        let currentSlideIndex = 0;
        const slides = document.querySelectorAll('.slide');

        function showSlide(index) {
            // Hide all slides
            slides.forEach(slide => {
                slide.classList.remove('active');
            });

            // Loop logic
            if (index >= slides.length) {
                currentSlideIndex = 0;
            } else if (index < 0) {
                currentSlideIndex = slides.length - 1;
            } else {
                currentSlideIndex = index;
            }

            // Show the current slide
            slides[currentSlideIndex].classList.add('active');
        }

        function changeSlide(direction) {
            showSlide(currentSlideIndex + direction);
        }
    </script>
</body>
</html>
